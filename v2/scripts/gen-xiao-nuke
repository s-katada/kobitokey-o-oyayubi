#!/usr/bin/env python3
"""gen-xiao-nuke — XIAO nRF52840 を「まっさら」に戻す UF2 を生成する。

kobu2-rmk-*-reset.uf2 (clear_layout ビルド) は保存済みキーマップを消すだけの
通常ファームウェアだが、こちらは MBR と Adafruit UF2 ブートローダ以外の
全ユーザーフラッシュを消去済み状態 (0xFF) に戻す:

    0x000000-0x001000  MBR                     残す (消すと SWD なしでは復旧不能)
    0x001000-0x0F4000  ← 本スクリプトの消去範囲
      うち 0x001000-0x0A0000  アプリ (RMK / ZMK / SoftDevice 跡地)
      うち 0x0A0000-0x0C0000  RMK storage (キーマップ + BLE ボンド + Vial 状態)
      うち 0x0C0000-0x0F4000  未使用域 (ZMK settings 等の過去の残骸を含む)
    0x0F4000-0x100000  Adafruit UF2 ブートローダ + 設定ページ  残す

実行コードは一切含まない「データだけ」の UF2。ページ消去はブートローダの
書き込みパスが行い、0xFF の書き込みは消去済みセルに対して no-op なので、
結果はフラッシュの工場出荷 (全消去) 状態になる。0x00 ではなく 0xFF を書く
のは、先頭ワード 0xFFFFFFFF をブートローダが「アプリなし」と判定して
リセット後も自動でブートローダ (XIAO-SENSE ドライブ) に留まるため。

nRF52840 + Adafruit UF2 ブートローダの組み合わせなら kobu v1/v2 どちらの
XIAO にも (他の XIAO BLE キーボードにも) 使える。

使い方:
    ./gen-xiao-nuke [出力パス]     # 省略時はスクリプト隣の xiao-nuke.uf2

出力は入力を持たない純粋関数なのでバイト単位で再現可能。CI は再生成して
コミット済みファイルと一致することを検証する。
"""

import hashlib
import struct
import sys
from pathlib import Path

UF2_MAGIC_0 = 0x0A324655  # "UF2\n"
UF2_MAGIC_1 = 0x9E5D5157
UF2_MAGIC_END = 0x0AB16F30
UF2_FLAG_FAMILY_ID = 0x2000
FAMILY_NRF52840 = 0xADA52840
PAYLOAD_SIZE = 256  # UF2 標準: 512B ブロック中 256B がデータ

FLASH_PAGE = 4096
START_ADDR = 0x1000  # MBR の直後
END_ADDR = 0xF4000  # Adafruit ブートローダの直前

assert START_ADDR % FLASH_PAGE == 0 and END_ADDR % FLASH_PAGE == 0
TOTAL_BLOCKS = (END_ADDR - START_ADDR) // PAYLOAD_SIZE


def main() -> None:
    out = Path(sys.argv[1]) if len(sys.argv) > 1 else Path(__file__).parent / "xiao-nuke.uf2"

    payload = b"\xff" * PAYLOAD_SIZE
    padding = b"\x00" * (476 - PAYLOAD_SIZE)
    footer = struct.pack("<I", UF2_MAGIC_END)

    with open(out, "wb") as f:
        for i in range(TOTAL_BLOCKS):
            header = struct.pack(
                "<IIIIIIII",
                UF2_MAGIC_0,
                UF2_MAGIC_1,
                UF2_FLAG_FAMILY_ID,
                START_ADDR + i * PAYLOAD_SIZE,
                PAYLOAD_SIZE,
                i,
                TOTAL_BLOCKS,
                FAMILY_NRF52840,
            )
            f.write(header + payload + padding + footer)

    digest = hashlib.sha256(out.read_bytes()).hexdigest()
    print(
        f"{out}: 0x{START_ADDR:X}-0x{END_ADDR:X} を 0xFF 化, "
        f"{TOTAL_BLOCKS} blocks, {out.stat().st_size} bytes, sha256 {digest}"
    )


if __name__ == "__main__":
    main()
